# === BOT ===
BOT_TOKEN="123456:ABC-DEF"
BOT_USERNAME="quototbot"
# Self-hosted Bot API server. Empty means api.telegram.org, which has no
# sendRichMessage (Bot API 10.3): the user agreement then renders as plain HTML
# instead of a natively formatted Markdown document. The bot says which one it
# got at startup.
TELEGRAM_BOT_API_BASE_URL=""

# === DATABASE ===
# LOCAL DEV: docker-compose builds the app's DB_URL from these POSTGRES_* vars
# and seeds a copy of the shared `core` schema (deploy/core-init.sql) into the
# bundled Postgres so the FKs into core.person/core.chat resolve.
POSTGRES_USER="quoto"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="quoto"
# Only needed when running the bot OUTSIDE docker (compose overrides this).
# PRODUCTION points DB_URL at the shared core-postgres as the quoto_core role,
# e.g. postgresql+asyncpg://quoto_core:***@core-postgres:5432/core
# (quoto's tables live in schema `quoto`; identity/language in schema `core`).
DB_URL="postgresql+asyncpg://quoto:change-me-to-a-strong-password@localhost:5432/quoto"

# === AI (Anthropic) ===
# Claude scores the day and describes photos, images and stickers. Set at least
# one of ANTHROPIC_API_KEY and OPENROUTER_API_KEY; with both, OpenRouter is the
# fallback for Claude and the only route for video and audio. An empty model
# skips Claude for that job.
ANTHROPIC_API_KEY=""
ANTHROPIC_EVAL_MODEL="claude-opus-5-5"
# low | medium | high | xhigh | max: how much the model thinks before answering.
ANTHROPIC_EVAL_EFFORT="medium"
ANTHROPIC_EVAL_MAX_TOKENS=32000
ANTHROPIC_MEDIA_MODEL="claude-sonnet-5-5"
ANTHROPIC_MEDIA_EFFORT="medium"
ANTHROPIC_MEDIA_MAX_TOKENS=8000

# === AI (OpenRouter) ===
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# Scores the day when Claude fails or has no key.
OPENROUTER_EVAL_MODEL="openai/gpt-6-luna"
# Used only if the primary eval model errors out after retries.
OPENROUTER_EVAL_FALLBACK_MODEL="google/gemini-3.1-flash-lite"
OPENROUTER_EVAL_REASONING_EFFORT="low"
OPENROUTER_EVAL_MAX_TOKENS=32000
OPENROUTER_MEDIA_MODEL="google/gemini-2.5-flash-lite"
# Per-kind primary media models. Empty = use OPENROUTER_MEDIA_MODEL.
# Chain per kind: specific -> OPENROUTER_MEDIA_MODEL -> FALLBACK below.
OPENROUTER_MEDIA_IMAGE_MODEL=""
OPENROUTER_MEDIA_VIDEO_MODEL=""
OPENROUTER_MEDIA_AUDIO_MODEL=""
# Used only if the primary media model errors out after retries.
OPENROUTER_MEDIA_FALLBACK_MODEL="google/gemini-3.1-flash-lite"
OPENROUTER_MEDIA_REASONING_EFFORT="medium"
# "deny" keeps chat text and media away from providers that train on it, and
# ZDR narrows that to endpoints that keep nothing: together they are what the
# user agreement promises. A model without such an endpoint (Meta's
# "contributor" tier, for one) fails over to its fallback.
OPENROUTER_DATA_COLLECTION="deny"
OPENROUTER_ZDR=True
OPENROUTER_HTTP_REFERER="https://t.me/quototbot"
OPENROUTER_APP_TITLE="Quoto"

# === MEDIA ===
MEDIA_ANALYSIS_ENABLED=True
MEDIA_PHASH_DISTANCE=5
MEDIA_CACHE_PROMPT_VERSION="v2"
MEDIA_IMAGE_MAX_SIDE=1280
MEDIA_IMAGE_QUALITY=82
MEDIA_VIDEO_MAX_SECONDS=3600
MEDIA_VIDEO_LOW_RES_MAX_SECONDS=10800
MEDIA_VIDEO_MAX_HEIGHT=720
MEDIA_VIDEO_CRF=30
MEDIA_VIDEO_FPS=12
MEDIA_AUDIO_BITRATE="64k"
MEDIA_AUDIO_SAMPLE_RATE=24000
MEDIA_COMMAND_TIMEOUT_SECONDS=300
MEDIA_PENDING_RETRY_INTERVAL_SECONDS=300
MEDIA_PENDING_RETRY_BATCH_SIZE=10
MEDIA_RETRY_MAX_ATTEMPTS=5
MEDIA_RETRY_BASE_DELAY_SECONDS=300
MEDIA_RETRY_MAX_DELAY_SECONDS=3600
MEDIA_PROVIDER_COOLDOWN_SECONDS=900
MEDIA_PENDING_ITEM_TIMEOUT_SECONDS=600

# === DEVELOPERS ===
ENABLE_DEVELOPERS_NOTIFY=False
DEVELOPER_IDS=[123456789]

# === SCHEDULER ===
QUOTE_HOUR=21
QUOTE_MINUTE=0
TIMEZONE="Europe/Kyiv"
MIN_MESSAGES_FOR_AUTO_REVIEW=10

# === LIMITS ===
# Max messages fed to the AI per group per day (cost safety). Groups above this
# keep only the most recent N and get a "context trimmed" note on the quote.
MAX_MESSAGES_PER_DAILY_EVAL=1500
# Premium groups bypass the message cap entirely. JSON list of chat ids.
PREMIUM_CHAT_IDS=[]

# === SCORING ===
# Final score is AI-only; reactions and length are sent/stored as context.
WEIGHT_REACTIONS=0.0
WEIGHT_AI=1.0
WEIGHT_LENGTH=0.0
