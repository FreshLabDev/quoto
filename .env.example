# === BOT ===
BOT_TOKEN="123456:ABC-DEF"
# Public username, with or without the @. Used for deep links and the
# OpenRouter attribution header.
BOT_USERNAME="quototbot"
# Self-hosted Bot API server. Empty means api.telegram.org, which has no
# sendRichMessage (Bot API 10.3): the user agreement then renders as plain HTML
# instead of a natively formatted Markdown document. The bot says which one it
# got at startup. When set, BOT_API_FILES_DIR is required: the server's data
# directory as this container sees it.
TELEGRAM_BOT_API_BASE_URL=""
BOT_API_FILES_DIR=""

# === DATABASE ===
# A postgres:// URL (the Python form postgresql+asyncpg:// is rejected). The
# production compose file builds it from QUOTO_CORE_PASSWORD; the test stack
# sets its own. search_path is set by the bot, not by the URL.
DATABASE_URL="postgres://quoto_core:change-me@localhost:5432/core"

# === AI (Anthropic) ===
# Claude scores the day and describes photos, images and stickers. Set at least
# one of ANTHROPIC_API_KEY and OPENROUTER_API_KEY; with both, OpenRouter is the
# fallback for Claude and the only route for video and audio. A model set to an
# empty string skips Claude for that job.
ANTHROPIC_API_KEY=""
ANTHROPIC_EVAL_MODEL="claude-opus-5-5"
# low | medium | high | xhigh | max: how much the model thinks before answering.
ANTHROPIC_EVAL_EFFORT="medium"
ANTHROPIC_MEDIA_MODEL="claude-sonnet-5-5"
ANTHROPIC_MEDIA_EFFORT="medium"

# === AI (OpenRouter) ===
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# Scores the day when Claude fails or has no key.
OPENROUTER_EVAL_MODEL="openai/gpt-6-luna"
# Used only if the primary eval model errors out after retries.
OPENROUTER_EVAL_FALLBACK_MODEL="google/gemini-3.1-flash-lite"
# none | minimal | low | medium | high | xhigh
OPENROUTER_EVAL_REASONING_EFFORT="low"
# Describes video and audio, and images when Claude is off or fails. Every model
# must have a zero-data-retention endpoint on OpenRouter: requests carry
# provider.zdr=true and data_collection=deny, which the user agreement promises.
OPENROUTER_MEDIA_MODEL="google/gemini-3.5-flash-lite"
OPENROUTER_MEDIA_FALLBACK_MODEL="google/gemini-3.1-flash-lite"
OPENROUTER_MEDIA_REASONING_EFFORT="medium"

# === MEDIA ===
# Cost switch for the whole bot. A group can also turn it off in its settings.
MEDIA_ANALYSIS_ENABLED=true

# === ACCESS ===
# Telegram ids that get alerts and the developer-only controls. A JSON list or
# a comma list. Empty means no alerts.
DEVELOPER_IDS=[123456789]
# Groups exempt from the daily message cap. Same format.
PREMIUM_CHAT_IDS=[]

# === RUNTIME ===
# Holds ai_audit.jsonl (real message text, seven days). Compose sets it.
# AUDIT_LOG_DIR="logs"
# Where /healthz listens.
# HTTP_ADDR=":8080"
# debug | info | warn | error
# LOG_LEVEL="info"
